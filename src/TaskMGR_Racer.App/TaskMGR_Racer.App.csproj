<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.20348.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <PlatformTarget>$(CpuArch)</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net8.0-windows10.0.20348.0\$(CpuArch)\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>TaskMGR_Racer.ico</ApplicationIcon>
    <RootNamespace>TaskMGR_Racer.App</RootNamespace>
    <AssemblyName>TaskMGR_Racer</AssemblyName>
    <Version>1.4.0.0</Version>
    <FileVersion>1.4.0.0</FileVersion>
    <InformationalVersion>1.4.0.0</InformationalVersion>
    <Product>TaskMGR_Racer</Product>
    <Authors>TaskMGR_Racer</Authors>
    <Description>Race on the Windows Task Manager CPU chart.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="TaskMGR_Racer.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskMGR_Racer.Overlay\TaskMGR_Racer.Overlay.csproj" />
    <ProjectReference Include="..\TaskMGR_Racer.Taskmgr\TaskMGR_Racer.Taskmgr.csproj" />
    <ProjectReference Include="..\TaskMGR_Racer.Capture\TaskMGR_Racer.Capture.csproj" />
    <ProjectReference Include="..\TaskMGR_Racer.Game\TaskMGR_Racer.Game.csproj" />
    <ProjectReference Include="..\TaskMGR_Racer.Native\TaskMGR_Racer.Native.csproj" />
    <ProjectReference Include="..\TaskMGR_Racer.Localization\TaskMGR_Racer.Localization.csproj" />
  </ItemGroup>

  <!-- Win desktop does not need package RID folders (e.g. System.Text.*.browser). -->
  <Target Name="StripUnusedRuntimeFolders"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_AppOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutputPath)'))</_AppOutDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_AppOutDir)runtimes" Condition="Exists('$(_AppOutDir)runtimes')" />
  </Target>

</Project>
